(function () {
  const NEWSLETTER_POPUP_KEY = 'newsletterPopupClosed';
  const NEWSLETTER_CODE_KEY = 'newsletterDiscountCode';
  const POPUP_DELAY_MS = 5000;
  const LOGO_URL = 'https://firebasestorage.googleapis.com/v0/b/merchct-d059a.firebasestorage.app/o/logo%2Flogo.jpg?alt=media';

  let initialized = false;
  let timerId = null;

  function createDiscountCode() {
    const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
    let randomPart = '';
    for (let i = 0; i < 6; i++) randomPart += chars[Math.floor(Math.random() * chars.length)];
    return `BIENVENIDA10-${randomPart}`;
  }

  function injectStyles() {
    if (document.getElementById('newsletterDiscountStyles')) return;
    const styles = document.createElement('style');
    styles.id = 'newsletterDiscountStyles';
    styles.textContent = `
      .newsletter-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.55);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 1700;
        padding: 18px;
      }
      .newsletter-overlay.show { display: flex; }
      .newsletter-modal {
        width: min(500px, 100%);
        background: #fff;
        color: #000;
        border-radius: 20px;
        padding: 28px 24px 24px;
        box-shadow: 0 22px 65px rgba(0,0,0,0.22);
        position: relative;
        border: 1px solid #e5e5e5;
        text-align: center;
      }
      .newsletter-close {
        position: absolute;
        top: 10px;
        right: 14px;
        border: none;
        background: none;
        font-size: 30px;
        cursor: pointer;
        color: #000;
      }
      .newsletter-image {
        width: 94px;
        height: 94px;
        object-fit: cover;
        border-radius: 50%;
        margin: 0 auto 14px;
        border: 2px solid #000;
        background: #f7f7f7;
      }
      .newsletter-gift-copy {
        margin: 0 0 10px;
        font-size: clamp(1.35rem, 4vw, 1.85rem);
        line-height: 1.12;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.4px;
      }
      .newsletter-title {
        margin: 0 0 8px;
        font-size: 1rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1px;
      }
      .newsletter-copy {
        margin: 0 0 16px;
        color: #555;
        line-height: 1.5;
        font-size: 0.92rem;
      }
      .newsletter-form { display: flex; gap: 8px; flex-wrap: wrap; }
      .newsletter-input {
        flex: 1;
        min-width: 200px;
        border: 1px solid #d8d8d8;
        background: #f7f7f7;
        color: #000;
        border-radius: 8px;
        padding: 11px 12px;
        font-size: 0.92rem;
        font-family: inherit;
      }
      .newsletter-submit {
        border: none;
        background: #000;
        color: #fff;
        border-radius: 8px;
        padding: 11px 14px;
        font-weight: 800;
        cursor: pointer;
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 1px;
      }
      .newsletter-error { color: #e63946; font-size: 0.84rem; margin-top: 8px; display: none; }
      .newsletter-success {
        margin-top: 14px;
        padding: 14px;
        border-radius: 10px;
        background: #f2fff7;
        border: 1px solid #b7ebc8;
        display: none;
        text-align: center;
      }
      .newsletter-success-code {
        display: inline-block;
        margin-top: 6px;
        font-weight: 900;
        font-size: 1rem;
        color: #087f3b;
        letter-spacing: 0.8px;
      }
    `;
    document.head.appendChild(styles);
  }

  function ensureMarkup() {
    let overlay = document.getElementById('newsletterOverlay');
    if (overlay) return overlay;

    overlay = document.createElement('div');
    overlay.className = 'newsletter-overlay';
    overlay.id = 'newsletterOverlay';
    overlay.setAttribute('aria-hidden', 'true');
    overlay.innerHTML = `
      <div class="newsletter-modal" role="dialog" aria-modal="true" aria-labelledby="newsletterTitle">
        <button class="newsletter-close" id="newsletterCloseBtn" aria-label="Cerrar">×</button>
        <img class="newsletter-image" src="${LOGO_URL}" alt="Tumerchmo descuento 10%">
        <p class="newsletter-gift-copy">Tumerchmo te regala un 10% de descuento en tu primera compra</p>
        <h3 id="newsletterTitle" class="newsletter-title">Obtén tu código de descuento</h3>
        <p class="newsletter-copy">Registra tu correo y recibe un código exclusivo para tu próxima compra.</p>
        <form class="newsletter-form" id="newsletterForm" novalidate>
          <input type="email" id="newsletterEmail" class="newsletter-input" placeholder="correo@ejemplo.com" required>
          <button type="submit" class="newsletter-submit">Obtener</button>
        </form>
        <p class="newsletter-error" id="newsletterError">Ingresa un correo válido para continuar.</p>
        <div class="newsletter-success" id="newsletterSuccess">
          ¡Registro exitoso! Tu código:
          <span class="newsletter-success-code" id="newsletterCode"></span>
          <p style="margin:6px 0 0; color:#087f3b; font-size:0.85rem;">Descuento: <strong>10% OFF</strong></p>
        </div>
      </div>
    `;
    document.body.appendChild(overlay);
    return overlay;
  }

  function closeNewsletterPopup(saveState = true) {
    const overlay = document.getElementById('newsletterOverlay');
    if (!overlay) return;
    overlay.classList.remove('show');
    overlay.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    if (saveState) localStorage.setItem(NEWSLETTER_POPUP_KEY, 'true');
  }

  function showNewsletterPopup() {
    if (localStorage.getItem(NEWSLETTER_POPUP_KEY) === 'true') return;
    const overlay = ensureMarkup();
    overlay.classList.add('show');
    overlay.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function bindEvents() {
    const overlay = ensureMarkup();
    const closeBtn = document.getElementById('newsletterCloseBtn');
    const form = document.getElementById('newsletterForm');
    const emailInput = document.getElementById('newsletterEmail');
    const error = document.getElementById('newsletterError');
    const success = document.getElementById('newsletterSuccess');
    const codeEl = document.getElementById('newsletterCode');

    closeBtn.onclick = () => closeNewsletterPopup(true);
    overlay.onclick = (event) => {
      if (event.target === overlay) closeNewsletterPopup(true);
    };
    form.onsubmit = (event) => {
      event.preventDefault();
      const email = emailInput.value.trim();
      const isValidEmail = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
      if (!isValidEmail) {
        error.style.display = 'block';
        success.style.display = 'none';
        return;
      }
      error.style.display = 'none';
      const existingCode = localStorage.getItem(NEWSLETTER_CODE_KEY);
      const code = existingCode || createDiscountCode();
      localStorage.setItem(NEWSLETTER_CODE_KEY, code);
      localStorage.setItem('newsletterEmail', email);
      codeEl.textContent = code;
      success.style.display = 'block';
    };
  }

  function initNewsletterPopup() {
    injectStyles();
    bindEvents();
    if (initialized) return;
    initialized = true;
    if (timerId) window.clearTimeout(timerId);
    timerId = window.setTimeout(showNewsletterPopup, POPUP_DELAY_MS);
  }

  window.createDiscountCode = createDiscountCode;
  window.closeNewsletterPopup = closeNewsletterPopup;
  window.showNewsletterPopup = showNewsletterPopup;
  window.initNewsletterPopup = initNewsletterPopup;

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initNewsletterPopup, { once: true });
  } else {
    initNewsletterPopup();
  }
})();
