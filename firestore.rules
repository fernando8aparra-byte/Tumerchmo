rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email in ['fernando8aparra@gmail.com'];
    }

    match /productos/{productoId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /contenido/{documentoId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /usuarios/{userId} {
      allow create: if signedIn() && request.auth.uid == userId;
      allow read, update: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    match /pedidos/{pedidoId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }
  }
}
